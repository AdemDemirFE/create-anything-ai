# Stack 08 web environment template.
# Copy to .env and replace EVERY placeholder with a value from your Supabase
# project settings (Project Settings -> API). Never commit .env.
#
# The two values below are PUBLIC by design in the BaaS model: the anon key is
# shipped to browsers and only constrains what RLS allows. The service_role
# key must NEVER appear here or in any client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
