# Local sqlite runtime database
laravel/database/database.sqlite
laravel/database/database.sqlite-journal

# Flutter artifacts (SDK not present, but keep ignored for future runs)
mobile/.dart_tool/
mobile/build/
mobile/pubspec.lock
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
