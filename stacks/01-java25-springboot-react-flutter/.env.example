# Stack 01 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env. Generate secrets with: openssl rand -base64 32

# --- PostgreSQL (compose + backend prod profile) ---
POSTGRES_USER=replace-with-local-username
POSTGRES_PASSWORD=replace-with-generated-local-secret
POSTGRES_DB=stack01

# --- Redis (compose only; no backend consumer yet) ---
REDIS_PASSWORD=replace-with-generated-local-secret

# --- Backend ---
# dev uses in-memory H2 and needs none of the values below.
SPRING_PROFILES_ACTIVE=dev
# prod profile (compose) resolves these from POSTGRES_* above:
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/stack01
# SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
# SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
