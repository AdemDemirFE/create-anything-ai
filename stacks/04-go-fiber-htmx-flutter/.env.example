# Stack 04 environment template.
# Copy to .env and adjust. Never commit .env.
# The reference backend needs NO secrets: data is in-memory and the session
# cookie is a random 256-bit value generated per login.

# --- Backend ---
# Listen port (default 8080).
# PORT=8080
# "true" when TLS terminates in front of the app: adds the Secure flag to
# the session cookie. Never set it for plain-HTTP local development.
# COOKIE_SECURE=false
# Comma-separated trusted proxy IPs/prefixes allowed to set X-Forwarded-For.
# LEAVE EMPTY unless the app actually sits behind the listed proxies: an
# empty value makes the login throttle use the direct connection address and
# IGNORE spoofable XFF headers entirely.
# TRUSTED_PROXIES=

# --- Compose (docker-compose.yml reads these) ---
# COOKIE_SECURE=false
# TRUSTED_PROXIES=
