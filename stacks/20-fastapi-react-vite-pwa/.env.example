# Stack 20 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env.
#
# Stack 20 requires NO secrets at runtime: session tokens are generated
# per-process with the OS CSPRNG and never persisted. The variables below
# are the complete set.

# --- Backend ---
# Set to 1/true ONLY when serving over TLS (behind a reverse proxy).
# Keeps the session cookie Secure-flagged. Leave empty for local dev.
# SECURE_COOKIES=

# CORS allowlist override (comma-separated origins). Defaults cover the
# local Vite dev server (5173) and preview (4173). Required for any
# non-localhost deployment.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
