# Stack 35 example environment. Copy to .env and adjust.
# Values below are non-reusable placeholders, not secrets.

# SignalR Redis backplane connection (compose -> backend).
# Used only when AddStacksRedis is wired in Program.cs (verification.md section 5).
STACK35_REDIS_CONNECTION=stack35-redis:6379

# Origin of the backend API as reached from the frontend container (compose).
STACK35_BACKEND_ORIGIN=http://backend:5080

# Local (non-compose) backend URL the Vite dev server proxies to.
STACK35_LOCAL_BACKEND_URL=http://localhost:5080
