# Stack 12 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env.
#
# Stack 12 requires NO secrets to run locally: the Firebase EMULATORS provide
# Auth + Firestore locally, the Functions layer talks to them over the
# loopback, and session tokens are generated per session with the OS CSPRNG
# (only SHA-256 digests are stored in Firestore). The variables below are the
# complete set; every one has a safe dev default.

# --- Firebase project ---
# Any project id works against the emulators; production deploys need a real
# project (UNVERIFIED in this environment — see verification.md).
# GCLOUD_PROJECT=stack12-demo

# --- Emulator hosts (set by `firebase emulators:exec` in tests) ---
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088

# --- Login throttle ---
# Fixed window per normalized email + peer IP. Window length and the
# retry-after hint are SEPARATE knobs (the two must not be coupled).
# LOGIN_THROTTLE_MAX_ATTEMPTS=5
# LOGIN_THROTTLE_WINDOW_MS=60000
# LOGIN_THROTTLE_RETRY_AFTER_SECONDS=60

# --- Sessions ---
# Sliding (idle) lifetime in minutes; Secure flag only behind TLS.
# SESSION_TTL_MINUTES=30
# SECURE_COOKIES=

# --- CORS ---
# Comma-separated allowlist for the Angular dev/preview origins. Required for
# any non-localhost deployment.
# ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4173

# --- Web (Angular) ---
# Base URL of the API. Web uses its own prefix base; never share the API
# prefix with static asset routes.
# STACK12_API_BASE_URL=http://127.0.0.1:5001/stack12-demo/europe-west1/api
