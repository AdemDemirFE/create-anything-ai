# Stack 23 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env.
#
# Stack 23 requires NO secrets at runtime in its default (offline) mode:
# embeddings come from LangChain's deterministic fake provider and vectors
# live in the local storage retriever. The variables below are the complete
# set; anything left unset keeps the safe default.

# --- Backend: RAG backends (adapter pattern) ---------------------------------
# Embedding provider: "fake" (default, offline, deterministic) or "openai".
# "openai" additionally requires the optional dependency `langchain-openai`
# (pip install langchain-openai) and reads OPENAI_API_KEY from the
# environment. NEVER put a real key in this file or any committed file.
# STACK23_EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY=<generate-your-own-key-do-not-commit>

# Vector store: "local" (default, file-backed brute-force cosine) or
# "qdrant" (real qdrant-client). For Qdrant:
#   - STACK23_QDRANT_IN_MEMORY=1 runs the client in :memory: mode (no server
#     needed; what the automated tests exercise).
#   - To use a real Qdrant server, set STACK23_QDRANT_IN_MEMORY=0 and point
#     STACK23_QDRANT_URL at it. This path is NOT runtime-verified in this
#     task (see verification.md unverified list).
# STACK23_VECTOR_STORE=local
# STACK23_QDRANT_IN_MEMORY=1
# STACK23_QDRANT_URL=<your-qdrant-server-url>
# STACK23_QDRANT_COLLECTION=stack23_chunks
# STACK23_LOCAL_STORAGE_DIR=.local_storage

# --- Backend: sessions / CORS -------------------------------------------------
# Set to 1/true ONLY when serving over TLS (behind a reverse proxy).
# SECURE_COOKIES=
# CORS allowlist override (comma-separated origins). Defaults cover the
# local Next.js dev server on port 3000. Required for any non-localhost
# deployment.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Web (Next.js) -------------------------------------------------------------
# Backend base URL for the same-origin API rewrite in next.config.mjs.
# Leave unset to use http://localhost:8000 in dev.
# STACK23_API_URL=http://localhost:8000
