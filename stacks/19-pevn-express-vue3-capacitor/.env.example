# Stack 19 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env.
#
# Stack 19 requires NO secrets at runtime: session tokens are generated per
# session with the OS CSPRNG and only SHA-256 digests are stored in MongoDB.
# The variables below are the complete set; every one has a safe dev default.

# --- Server ---
# PORT=4000

# MongoDB connection string. Tests always spin up their own in-process
# mongod via mongodb-memory-server and ignore this value.
# MONGODB_URI=mongodb://localhost:27017/stack19

# Sliding (idle) session lifetime in minutes.
# SESSION_TTL_MINUTES=30

# Set to 1/true ONLY when serving over TLS (behind a reverse proxy).
# Keeps the stack19_session cookie Secure-flagged. Leave empty for local dev.
# SECURE_COOKIES=

# CORS allowlist override (comma-separated origins). Defaults cover the
# local Vite dev server (5173) and preview (4173). Required for any
# non-localhost deployment.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Login throttle ---
# Fixed window per email + TCP peer IP. Window length and the retry-after
# hint are SEPARATE knobs (the two must not be coupled).
# LOGIN_THROTTLE_WINDOW_SECONDS=60
# LOGIN_THROTTLE_MAX_FAILURES=5
# LOGIN_THROTTLE_RETRY_AFTER_SECONDS=60

# --- bcrypt (runs inside worker_threads) ---
# BCRYPT_ROUNDS=12
# BCRYPT_WORKERS=4
