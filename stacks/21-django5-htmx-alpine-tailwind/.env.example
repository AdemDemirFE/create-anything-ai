# Stack 21 environment template (Django 5 + htmx + Alpine + Tailwind).
# Copy to .env and adjust. Never commit .env.
# Values below are non-reusable placeholders, not secrets.

# --- Django core ---
# REQUIRED in production (DJANGO_DEBUG=false). Generate with:
#   python -c "import secrets; print(secrets.get_random_string(50))"
DJANGO_SECRET_KEY=change-me-to-a-real-random-value
# false in production; true only for local development.
DJANGO_DEBUG=true
# Comma-separated hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Session/CSRF cookies ---
# true ONLY when TLS terminates in front of the app. Never for plain-HTTP
# local development.
SESSION_COOKIE_SECURE=false
# Idle session lifetime in seconds (default 1800 = 30 minutes).
SESSION_COOKIE_AGE_SECONDS=1800

# --- Login throttle ---
# Failed attempts allowed per email+IP inside the window before 429.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_WINDOW_SECONDS=60
# Comma-separated trusted proxy IPs. LEAVE EMPTY unless the app actually sits
# behind these proxies: an empty value makes the throttle use the direct
# connection address and IGNORE spoofable X-Forwarded-For headers entirely.
TRUSTED_PROXIES=

# --- Workbench bounds ---
# Max algorithm input length in characters; max request body in bytes.
MAX_INPUT_CHARS=10000
MAX_BODY_BYTES=262144
