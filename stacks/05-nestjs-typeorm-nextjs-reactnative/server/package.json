{
  "name": "stack05-server",
  "private": true,
  "version": "0.1.0",
  "description": "Stack 05 server: NestJS 11 + TypeORM (better-sqlite3 driver), cookie sessions (opaque token, SHA-256 hashed at rest), documents CRUD + fixed-catalog algorithm workbench. Tests run on a REAL SQLite database via better-sqlite3 in-memory mode (vitest + supertest).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.12",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "^1.16.20",
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "2.1.9"
  }
}
