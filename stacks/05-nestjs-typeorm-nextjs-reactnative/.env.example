# Stack 05 environment template.
# Copy to .env and replace EVERY placeholder with a locally generated value.
# Never commit .env.
#
# Stack 05 requires NO secrets at runtime: session tokens are generated per
# session with the OS CSPRNG and only SHA-256 digests are stored in SQLite/
# PostgreSQL. The variables below are the complete set; every one has a safe
# dev default.

# --- Server (NestJS) ---
# PORT=4000

# TypeORM connection. Tests ALWAYS run on better-sqlite3 ':memory:' and ignore
# this value. Production swaps the driver + migrations (see ARCHITECTURE.md).
# SQLITE_PATH=./stack05.sqlite

# --- Session ---
# Idle lifetime in minutes; HttpOnly, SameSite=Lax cookie.
# SESSION_TTL_MINUTES=30
# COOKIE_NAME=stack05_session

# Set to 1/true ONLY when serving over TLS (behind a reverse proxy). Keeps the
# session cookie Secure-flagged. Leave empty for local dev.
# SECURE_COOKIES=

# CORS allowlist override (comma-separated origins). Defaults cover the local
# Next.js dev server (3000). Required for any non-localhost deployment.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Login throttle ---
# Fixed window per (normalized email, TCP peer IP). The 429 response carries
# Retry-After computed from LOGIN_THROTTLE_RETRY_AFTER_SECONDS.
# LOGIN_THROTTLE_WINDOW_SECONDS=60
# LOGIN_THROTTLE_MAX_FAILURES=5
# LOGIN_THROTTLE_RETRY_AFTER_SECONDS=60

# --- Algorithm workbench ---
# Effective input bound in characters. TIGHTEN-ONLY: values above
# ALGORITHM_ABSOLUTE_MAX_INPUT (100000) or invalid values fall back to the
# default 10000; the engine is the single source of truth for the bound.
# ALGORITHM_MAX_INPUT=10000
# ALGORITHM_ABSOLUTE_MAX_INPUT=100000

# --- Web (Next.js) ---
# Where the /api/v1 rewrite proxies API calls (dev convenience).
# API_ORIGIN=http://localhost:4000

# --- Mobile (React Native / Expo) ---
# Base URL the RN shell uses for the shared ApiClient. The default targets
# the Android emulator loopback alias; use your LAN IP on real devices.
# EXPO_PUBLIC_API_BASE=http://10.0.2.2:4000/api/v1
