# Stack 02 backend — safe defaults template.
# Copy to .env locally; NEVER commit real secrets.
# Used only by the `prod` profile / docker compose (unverified; H2 dev/test needs none of these).

# Comma-separated CORS allowlist for the Angular web client.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# PostgreSQL (prod profile) — required only outside dev/test.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stack02
SPRING_DATASOURCE_USERNAME=stack02
# SPRING_DATASOURCE_PASSWORD=<real secret; never commit>
