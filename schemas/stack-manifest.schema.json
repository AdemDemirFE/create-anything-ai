{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/stack-manifest.schema.json",
  "title": "Create Anything AI Stack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "maturity",
    "description",
    "requires",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "description": "Must be one of the category slugs declared in stacks/catalog.json categoryPolicy.",
      "$ref": "catalog.schema.json#/$defs/category"
    },
    "maturity": {
      "$ref": "catalog.schema.json#/$defs/maturity"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "backend": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "language",
        "framework"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "web": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "framework"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "buildTool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "mobile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "framework"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "desktop": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "framework"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux",
          "macos",
          "windows",
          "ios",
          "android",
          "web"
        ]
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "description": "Free-form map of component name to version string (for example \"java\": \"25\"). Values must be version-like strings, not prose.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+_\\-]*$"
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "manifest",
        "unit",
        "integration",
        "e2e"
      ],
      "properties": {
        "manifest": {
          "type": "boolean"
        },
        "unit": {
          "type": "boolean"
        },
        "integration": {
          "type": "boolean"
        },
        "e2e": {
          "type": "boolean"
        },
        "lastVerifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidencePath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
